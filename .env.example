# Supabase Configuration
# Get these from: https://supabase.com → Your Project → Settings → API

# Your Supabase project URL (safe to expose — it's the public API endpoint)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (safe to expose — RLS enforces security)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NEVER add the service_role key here — it must NEVER be exposed to the frontend

